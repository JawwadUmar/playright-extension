{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Locator Lens — Playwright Selector",
  "short_name": "Locator Lens",
  "version": "1.0.0",
  "description": "Hover over any element, verify a unique Playwright locator, and copy Python or JavaScript.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "clipboardWrite", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Locator Lens",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle",
    "world": "ISOLATED"
  }],
  "commands": {
    "toggle-inspection": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Enable or disable inspection" },
    "copy-selector": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Copy the current verified selector" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
